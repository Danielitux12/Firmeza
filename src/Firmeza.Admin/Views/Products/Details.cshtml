@model Firmeza.Application.ViewModels.Products.ProductViewModel
@{
    ViewData["Title"] = "Detalle del Producto";
}

<div class="row justify-content-center">
    <div class="col-12 col-lg-8">
        <div class="card card-firmeza">
            <div class="card-header bg-white py-3 d-flex justify-content-between align-items-center">
                <h5 class="card-title mb-0 fw-bold">Detalle del Producto #@Model.Id</h5>
                <a asp-action="Index" class="btn btn-sm btn-outline-secondary">
                    <i class="bi bi-arrow-left me-1"></i> Volver al listado
                </a>
            </div>
            <div class="card-body p-4">
                <div class="row g-4">
                    <div class="col-md-6">
                        <label class="text-muted small text-uppercase fw-semibold d-block">Nombre Comercial</label>
                        <span class="fs-5 fw-bold">@Model.Name</span>
                    </div>

                    <div class="col-md-6">
                        <label class="text-muted small text-uppercase fw-semibold d-block">Categoría</label>
                        <span class="badge bg-secondary fs-6">@Model.Category</span>
                    </div>

                    <div class="col-md-4">
                        <label class="text-muted small text-uppercase fw-semibold d-block">Precio Unitario</label>
                        <span class="fs-4 text-primary fw-bold">$@Model.Price.ToString("N2")</span>
                    </div>

                    <div class="col-md-4">
                        <label class="text-muted small text-uppercase fw-semibold d-block">Stock en Bodega</label>
                        <span class="fs-4 fw-bold">@Model.Stock unidades</span>
                    </div>

                    <div class="col-md-4">
                        <label class="text-muted small text-uppercase fw-semibold d-block">Estado</label>
                        @if (Model.IsAvailable)
                        {
                            <span class="badge-available">Disponible para venta</span>
                        }
                        else
                        {
                            <span class="badge-unavailable">No disponible / Agotado</span>
                        }
                    </div>

                    <div class="col-12">
                        <label class="text-muted small text-uppercase fw-semibold d-block">Descripción</label>
                        <p class="mb-0 bg-light p-3 rounded border">
                            @(string.IsNullOrWhiteSpace(Model.Description) ? "Sin descripción detallada." : Model.Description)
                        </p>
                    </div>
                </div>

                <hr class="my-4" />

                <div class="d-flex justify-content-end gap-2">
                    <a asp-action="Edit" asp-route-id="@Model.Id" class="btn btn-primary">
                        <i class="bi bi-pencil me-1"></i> Editar
                    </a>
                    <a asp-action="Delete" asp-route-id="@Model.Id" class="btn btn-outline-danger">
                        <i class="bi bi-trash me-1"></i> Eliminar
                    </a>
                </div>
            </div>
        </div>
    </div>
</div>
