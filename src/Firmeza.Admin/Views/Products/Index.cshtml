@model Firmeza.Application.ViewModels.Products.ProductFilterViewModel
@{
    ViewData["Title"] = "Catálogo de Productos";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <div>
        <h2 class="fw-bold mb-1">Catálogo de Productos</h2>
        <p class="text-muted mb-0">Gestión de inventario y artículos de ferretería</p>
    </div>
    <div class="d-flex gap-2">
        <a asp-action="ExportExcel" class="btn btn-outline-success">
            <i class="bi bi-file-earmark-excel me-1"></i> Exportar Excel
        </a>
        <a asp-action="ExportPdf" class="btn btn-outline-danger">
            <i class="bi bi-file-earmark-pdf me-1"></i> Exportar PDF
        </a>
        <a asp-action="Create" class="btn btn-primary">
            <i class="bi bi-plus-circle me-1"></i> Nuevo Producto
        </a>
    </div>
</div>

<!-- Filtros de búsqueda por nombre, categoría y disponibilidad -->
<div class="card card-firmeza mb-4">
    <div class="card-body">
        <form method="get" asp-action="Index" class="row g-3 align-items-end">
            <div class="col-12 col-md-4">
                <label class="form-label small fw-semibold">Buscar por Nombre</label>
                <div class="input-group">
                    <span class="input-group-text bg-white"><i class="bi bi-search"></i></span>
                    <input type="text" name="searchName" value="@Model.SearchName" class="form-control" placeholder="Ej. Cemento, Tubo, Pintura..." />
                </div>
            </div>

            <div class="col-12 col-md-3">
                <label class="form-label small fw-semibold">Categoría</label>
                <select name="selectedCategory" class="form-select">
                    <option value="">-- Todas las categorías --</option>
                    @foreach (var cat in Model.AvailableCategories)
                    {
                        <option value="@cat" selected="@(Model.SelectedCategory == cat ? "selected" : null)">@cat</option>
                    }
                </select>
            </div>

            <div class="col-12 col-md-3">
                <label class="form-label small fw-semibold">Disponibilidad</label>
                <select name="availabilityFilter" class="form-select">
                    <option value="">-- Todos los estados --</option>
                    <option value="true" selected="@(Model.AvailabilityFilter == true ? "selected" : null)">Solo Disponibles</option>
                    <option value="false" selected="@(Model.AvailabilityFilter == false ? "selected" : null)">No Disponibles</option>
                </select>
            </div>

            <div class="col-12 col-md-2 d-flex gap-2">
                <button type="submit" class="btn btn-primary w-100">
                    <i class="bi bi-funnel me-1"></i> Filtrar
                </button>
                <a asp-action="Index" class="btn btn-outline-secondary" title="Limpiar filtros">
                    <i class="bi bi-arrow-counterclockwise"></i>
                </a>
            </div>
        </form>
    </div>
</div>

<!-- Listado de productos en tabla -->
<div class="card card-firmeza">
    <div class="table-responsive">
        <table class="table table-firmeza">
            <thead>
                <tr>
                    <th>Nombre</th>
                    <th>Categoría</th>
                    <th>Precio</th>
                    <th>Stock</th>
                    <th>Disponibilidad</th>
                    <th class="text-end">Acciones</th>
                </tr>
            </thead>
            <tbody>
                @if (Model.Products.Count == 0)
                {
                    <tr>
                        <td colspan="6" class="text-center py-5 text-muted">
                            <i class="bi bi-inbox fs-1 d-block mb-2"></i>
                            No se encontraron productos con los filtros aplicados.
                        </td>
                    </tr>
                }
                else
                {
                    @foreach (var product in Model.Products)
                    {
                        <tr>
                            <td>
                                <div class="fw-bold">@product.Name</div>
                                <small class="text-muted text-truncate d-inline-block" style="max-width: 250px;">
                                    @product.Description
                                </small>
                            </td>
                            <td>
                                <span class="badge bg-light text-dark border">@product.Category</span>
                            </td>
                            <td class="fw-semibold">
                                $@product.Price.ToString("N2")
                            </td>
                            <td>
                                <span class="@(product.Stock <= 5 ? "text-danger fw-bold" : "")">
                                    @product.Stock unids.
                                </span>
                            </td>
                            <td>
                                @if (product.IsAvailable)
                                {
                                    <span class="badge-available">Disponible</span>
                                }
                                else
                                {
                                    <span class="badge-unavailable">Agotado / Inactivo</span>
                                }
                            </td>
                            <td class="text-end">
                                <div class="btn-group btn-group-sm">
                                    <a asp-action="Details" asp-route-id="@product.Id" class="btn btn-outline-secondary" title="Ver Detalle">
                                        <i class="bi bi-eye"></i>
                                    </a>
                                    <a asp-action="Edit" asp-route-id="@product.Id" class="btn btn-outline-primary" title="Editar">
                                        <i class="bi bi-pencil"></i>
                                    </a>
                                    <a asp-action="Delete" asp-route-id="@product.Id" class="btn btn-outline-danger" title="Eliminar">
                                        <i class="bi bi-trash"></i>
                                    </a>
                                </div>
                            </td>
                        </tr>
                    }
                }
            </tbody>
        </table>
    </div>
</div>
