@model Firmeza.Application.ViewModels.Products.ProductViewModel
@{
    ViewData["Title"] = "Eliminar Producto";
}

<div class="row justify-content-center">
    <div class="col-12 col-lg-6">
        <div class="card card-firmeza border-danger">
            <div class="card-header bg-danger text-white py-3">
                <h5 class="card-title mb-0 fw-bold">
                    <i class="bi bi-exclamation-triangle-fill me-2"></i> Confirmar Eliminación
                </h5>
            </div>
            <div class="card-body p-4 text-center">
                <p class="text-muted fs-5 mb-3">
                    ¿Estás seguro de que deseas eliminar este producto?
                </p>

                <div class="bg-light p-3 rounded border text-start mb-4">
                    <div class="fw-bold fs-5 mb-1">@Model.Name</div>
                    <div class="text-muted small mb-2">Categoría: @Model.Category</div>
                    <div class="d-flex justify-content-between">
                        <span>Precio: <strong>$@Model.Price.ToString("N2")</strong></span>
                        <span>Stock: <strong>@Model.Stock unids.</strong></span>
                    </div>
                </div>

                <div class="alert alert-warning small text-start">
                    <i class="bi bi-info-circle me-1"></i>
                    <strong>Nota:</strong> Si el producto tiene ventas asociadas, no se borrará físicamente para preservar el historial, sino que se marcará como <em>No Disponible</em>.
                </div>

                <form asp-action="Delete" asp-route-id="@Model.Id" method="post">
                    @Html.AntiForgeryToken()
                    <div class="d-flex justify-content-center gap-3">
                        <a asp-action="Index" class="btn btn-outline-secondary px-4">Cancelar</a>
                        <button type="submit" class="btn btn-danger px-4">
                            <i class="bi bi-trash me-1"></i> Sí, Eliminar
                        </button>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>
