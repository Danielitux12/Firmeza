@model Firmeza.Application.ViewModels.Customers.CustomerViewModel
@{
    ViewData["Title"] = "Nuevo Cliente";
}

<div class="row justify-content-center">
    <div class="col-12 col-lg-8">
        <div class="card card-firmeza">
            <div class="card-header bg-white py-3 d-flex justify-content-between align-items-center">
                <h5 class="card-title mb-0 fw-bold">Registrar Nuevo Cliente</h5>
                <a asp-action="Index" class="btn btn-sm btn-outline-secondary">
                    <i class="bi bi-arrow-left me-1"></i> Volver al listado
                </a>
            </div>
            <div class="card-body p-4">
                <form asp-action="Create" method="post">
                    @Html.AntiForgeryToken()

                    <div class="row g-3">
                        <div class="col-md-7">
                            <label asp-for="FullName" class="form-label fw-semibold"></label>
                            <input asp-for="FullName" class="form-control" placeholder="Ej. Carlos Mendoza García" />
                            <span asp-validation-for="FullName" class="text-danger small"></span>
                        </div>

                        <div class="col-md-5">
                            <label asp-for="DocumentNumber" class="form-label fw-semibold"></label>
                            <input asp-for="DocumentNumber" class="form-control" placeholder="Ej. 1020304050" />
                            <span asp-validation-for="DocumentNumber" class="text-danger small"></span>
                        </div>

                        <div class="col-md-6">
                            <label asp-for="Email" class="form-label fw-semibold"></label>
                            <div class="input-group">
                                <span class="input-group-text"><i class="bi bi-envelope"></i></span>
                                <input asp-for="Email" type="email" class="form-control" placeholder="carlos@correo.com" />
                            </div>
                            <span asp-validation-for="Email" class="text-danger small"></span>
                        </div>

                        <div class="col-md-6">
                            <label asp-for="Phone" class="form-label fw-semibold"></label>
                            <div class="input-group">
                                <span class="input-group-text"><i class="bi bi-telephone"></i></span>
                                <input asp-for="Phone" class="form-control" placeholder="3001234567" />
                            </div>
                            <span asp-validation-for="Phone" class="text-danger small"></span>
                        </div>

                        <!-- Campo Edad recibido como texto plano para validación por try-catch -->
                        <div class="col-md-4">
                            <label asp-for="AgeText" class="form-label fw-semibold"></label>
                            <input asp-for="AgeText" type="text" class="form-control" placeholder="Ej. 35" />
                            <small class="text-muted d-block">Ingrese el número de años cumplidos</small>
                            <span asp-validation-for="AgeText" class="text-danger small"></span>
                        </div>

                        <div class="col-md-8">
                            <label asp-for="Address" class="form-label fw-semibold"></label>
                            <input asp-for="Address" class="form-control" placeholder="Calle 45 # 12-34, Bogotá" />
                            <span asp-validation-for="Address" class="text-danger small"></span>
                        </div>
                    </div>

                    <hr class="my-4" />

                    <div class="d-flex justify-content-end gap-2">
                        <a asp-action="Index" class="btn btn-outline-secondary">Cancelar</a>
                        <button type="submit" class="btn btn-success px-4">
                            <i class="bi bi-person-check me-1"></i> Guardar Cliente
                        </button>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>
