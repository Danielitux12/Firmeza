@model Firmeza.Application.ViewModels.Empresas.EmpresaFilterViewModel
@{
    ViewData["Title"] = "Empresas";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <div>
        <h2 class="fw-bold mb-1">Empresas proveedoras</h2>
        <p class="text-muted mb-0">Gestión de empresas y datos de contacto</p>
    </div>
    <a asp-action="Create" class="btn btn-primary"><i class="bi bi-plus-lg me-1"></i>Nueva empresa</a>
</div>

<div class="card card-firmeza mb-4">
    <div class="card-body">
        <form method="get" asp-action="Index" class="row g-3 align-items-end">
            <div class="col-12 col-md-7">
                <label for="search" class="form-label small fw-semibold">Buscar</label>
                <input id="search" name="search" value="@Model.Search" class="form-control" placeholder="Razón social, NIT o correo" />
            </div>
            <div class="col-12 col-md-3">
                <label for="status" class="form-label small fw-semibold">Estado</label>
                <select id="status" name="status" class="form-select">
                    <option value="active" selected="@(Model.Status == "active" ? "selected" : null)">Activas</option>
                    <option value="inactive" selected="@(Model.Status == "inactive" ? "selected" : null)">Suspendidas</option>
                    <option value="all" selected="@(Model.Status == "all" ? "selected" : null)">Todas</option>
                </select>
            </div>
            <input type="hidden" name="pageSize" value="@Model.PageSize" />
            <div class="col-12 col-md-2 d-flex gap-2">
                <button type="submit" class="btn btn-primary">Filtrar</button>
                <a asp-action="Index" asp-route-status="active" class="btn btn-outline-secondary" title="Limpiar filtros"><i class="bi bi-arrow-counterclockwise"></i></a>
            </div>
        </form>
    </div>
</div>

<div class="card card-firmeza">
    <div class="table-responsive">
        <table class="table table-firmeza">
            <thead>
                <tr><th>Razón social</th><th>NIT</th><th>Correo</th><th>Teléfono</th><th>Estado</th><th class="text-end">Acciones</th></tr>
            </thead>
            <tbody>
            @if (Model.Items.Count == 0)
            {
                <tr><td colspan="6" class="text-center text-muted py-5">No hay empresas para mostrar.</td></tr>
            }
            else
            {
                @foreach (var empresa in Model.Items)
                {
                    <tr>
                        <td><div class="fw-semibold">@empresa.Name</div><small class="text-muted">@empresa.Address</small></td>
                        <td class="font-monospace">@empresa.Nit</td>
                        <td><a href="mailto:@empresa.Email">@empresa.Email</a></td>
                        <td>@empresa.Phone</td>
                        <td><span class="badge @(empresa.IsActive ? "bg-success-subtle text-success" : "bg-secondary-subtle text-secondary")">@(empresa.IsActive ? "Activa" : "Suspendida")</span></td>
                        <td class="text-end">
                            <div class="btn-group btn-group-sm">
                                <a asp-action="Edit" asp-route-id="@empresa.Id" class="btn btn-outline-primary" title="Editar"><i class="bi bi-pencil"></i></a>
                                <form asp-action="@(empresa.IsActive ? "Suspend" : "Activate")" asp-route-id="@empresa.Id" method="post">
                                    @Html.AntiForgeryToken()
                                    <button class="btn btn-outline-@(empresa.IsActive ? "warning" : "success")" title="@(empresa.IsActive ? "Suspender" : "Activar")"><i class="bi bi-@(empresa.IsActive ? "pause-circle" : "play-circle")"></i></button>
                                </form>
                            </div>
                        </td>
                    </tr>
                }
            }
            </tbody>
        </table>
    </div>
</div>

<nav class="d-flex justify-content-between align-items-center mt-3" aria-label="Paginación de empresas">
    <span class="text-muted small">@Model.TotalCount empresas · página @Model.Page de @Math.Max(Model.TotalPages, 1)</span>
    <div class="btn-group btn-group-sm">
        <a asp-action="Index" asp-route-page="@(Model.Page - 1)" asp-route-pageSize="@Model.PageSize" asp-route-search="@Model.Search" asp-route-status="@Model.Status" class="btn btn-outline-secondary @(Model.Page <= 1 ? "disabled" : "")">Anterior</a>
        <a asp-action="Index" asp-route-page="@(Model.Page + 1)" asp-route-pageSize="@Model.PageSize" asp-route-search="@Model.Search" asp-route-status="@Model.Status" class="btn btn-outline-secondary @(Model.Page >= Model.TotalPages ? "disabled" : "")">Siguiente</a>
    </div>
</nav>