<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Firmeza Admin</title>

    <!-- Bootstrap 5 por CDN para simplificar -->
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet" />
    <!-- Bootstrap Icons por CDN -->
    <link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" rel="stylesheet" />

    <!-- Estilos globales coherentes del panel -->
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
</head>
<body>
@if (User.Identity?.IsAuthenticated == true)
{
    <div class="app-container">
        <!-- Sidebar lateral de navegación -->
        <aside class="sidebar">
            <div class="sidebar-header">
                <i class="bi bi-hammer text-warning"></i>
                <span>Firmeza Admin</span>
            </div>
            <ul class="sidebar-menu">
                <li>
                    <a asp-controller="Home" asp-action="Index" class="@(ViewContext.RouteData.Values["Controller"]?.ToString() == "Home" ? "active" : "")">
                        <i class="bi bi-speedometer2"></i>
                        <span>Inicio</span>
                    </a>
                </li>
                <li>
                    <a asp-controller="Products" asp-action="Index" class="@(ViewContext.RouteData.Values["Controller"]?.ToString() == "Products" ? "active" : "")">
                        <i class="bi bi-box-seam"></i>
                        <span>Productos</span>
                    </a>
                </li>
                <li>
                    <a asp-controller="Clientes" asp-action="Index" class="@(ViewContext.RouteData.Values["Controller"]?.ToString() == "Clientes" ? "active" : "")">
                        <i class="bi bi-people"></i>
                        <span>Clientes</span>
                    </a>
                </li>
                <li>
                    <a asp-controller="Empresas" asp-action="Index" class="@(ViewContext.RouteData.Values["Controller"]?.ToString() == "Empresas" ? "active" : "")">
                        <i class="bi bi-building"></i>
                        <span>Empresas</span>
                    </a>
                </li>
                <li>
                    <a asp-controller="Sales" asp-action="Index" class="@(ViewContext.RouteData.Values["Controller"]?.ToString() == "Sales" ? "active" : "")">
                        <i class="bi bi-receipt"></i>
                        <span>Ventas</span>
                    </a>
                </li>
                <li>
                    <a asp-controller="Import" asp-action="Index" class="@(ViewContext.RouteData.Values["Controller"]?.ToString() == "Import" ? "active" : "")">
                        <i class="bi bi-file-earmark-excel"></i>
                        <span>Importar Excel</span>
                    </a>
                </li>
            </ul>
            <div class="sidebar-footer">
                <small class="text-secondary d-block">Usuario Administrador</small>
                <span class="text-light text-truncate d-block">@User.Identity.Name</span>
            </div>
        </aside>

        <!-- Contenedor principal -->
        <div class="main-content">
            <!-- Header superior -->
            <header class="top-navbar">
                <div class="fw-semibold text-secondary">
                    Panel de Control &bull; @ViewData["Title"]
                </div>
                <div class="d-flex align-items-center gap-3">
                    <span class="badge bg-primary px-3 py-2">
                        <i class="bi bi-shield-lock me-1"></i> Administrador
                    </span>
                    <a asp-controller="Account" asp-action="Logout" class="btn btn-outline-danger btn-sm">
                        <i class="bi bi-box-arrow-right me-1"></i> Cerrar Sesión
                    </a>
                </div>
            </header>

            <!-- Cuerpo del contenido -->
            <main class="content-body">
                <!-- Alertas de éxito, advertencia y error -->
                @if (TempData["SuccessMessage"] != null)
                {
                    <div class="alert alert-success alert-dismissible fade show shadow-sm" role="alert">
                        <i class="bi bi-check-circle-fill me-2"></i> @TempData["SuccessMessage"]
                        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Cerrar"></button>
                    </div>
                }
                @if (TempData["WarningMessage"] != null)
                {
                    <div class="alert alert-warning alert-dismissible fade show shadow-sm" role="alert">
                        <i class="bi bi-exclamation-triangle-fill me-2"></i> @TempData["WarningMessage"]
                        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Cerrar"></button>
                    </div>
                }
                @if (TempData["ErrorMessage"] != null)
                {
                    <div class="alert alert-danger alert-dismissible fade show shadow-sm" role="alert">
                        <i class="bi bi-x-octagon-fill me-2"></i> @TempData["ErrorMessage"]
                        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Cerrar"></button>
                    </div>
                }

                @RenderBody()
            </main>

            <!-- Footer -->
            <footer class="footer d-flex justify-content-between align-items-center">
                <span>&copy; @DateTime.UtcNow.Year Firmeza Materiales y Ferretería. Todos los derechos reservados.</span>
                <span class="text-muted">Versión 1.0 (Admin)</span>
            </footer>
        </div>
    </div>
}
else
{
    <!-- Vista pública o de login sin sidebar -->
    <main class="container py-4">
        @RenderBody()
    </main>
}

<!-- Bootstrap 5 Bundle JS por CDN -->
<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
@await RenderSectionAsync("Scripts", required: false)
</body>
</html>