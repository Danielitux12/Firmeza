@model Firmeza.Application.ViewModels.Clientes.ClienteFilterViewModel
@{
    ViewData["Title"] = "Gestión de Clientes";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <div>
        <h2 class="fw-bold mb-1">Cartera de Clientes</h2>
        <p class="text-muted mb-0">Directorio de clientes registrados y contactos</p>
    </div>
    <div class="d-flex gap-2">
        <a asp-action="ExportExcel" class="btn btn-outline-success">
            <i class="bi bi-file-earmark-excel me-1"></i> Exportar Excel
        </a>
        <a asp-action="ExportPdf" class="btn btn-outline-danger">
            <i class="bi bi-file-earmark-pdf me-1"></i> Exportar PDF
        </a>
        <a asp-action="Create" class="btn btn-success">
            <i class="bi bi-person-plus me-1"></i> Nuevo Cliente
        </a>
    </div>
</div>

<!-- Filtros de búsqueda y estado -->
<div class="card card-firmeza mb-4">
    <div class="card-body">
        <form method="get" asp-action="Index" class="row g-3 align-items-end">
            <div class="col-12 col-md-6">
                <div class="input-group">
                    <span class="input-group-text bg-white"><i class="bi bi-search"></i></span>
                    <input type="text" name="search" value="@Model.SearchTerm" class="form-control" placeholder="Nombre, correo o documento" />
                </div>
            </div>
            <div class="col-12 col-md-3">
                <label class="form-label small fw-semibold" for="status">Estado</label>
                <select id="status" name="status" class="form-select">
                    <option value="active" selected="@(Model.Status == "active" ? "selected" : null)">Activos</option>
                    <option value="inactive" selected="@(Model.Status == "inactive" ? "selected" : null)">Suspendidos</option>
                    <option value="all" selected="@(Model.Status == "all" ? "selected" : null)">Todos</option>
                </select>
            </div>
            <input type="hidden" name="pageSize" value="@Model.PageSize" />
            <div class="col-12 col-md-3 d-flex gap-2">
                <button type="submit" class="btn btn-primary">
                    <i class="bi bi-search me-1"></i> Buscar
                </button>
                <a asp-action="Index" asp-route-status="active" class="btn btn-outline-secondary" title="Limpiar filtros">
                    <i class="bi bi-arrow-counterclockwise"></i>
                </a>
            </div>
        </form>
    </div>
</div>

<!-- Tabla de clientes -->
<div class="card card-firmeza">
    <div class="table-responsive">
        <table class="table table-firmeza">
            <thead>
                <tr>
                    <th>Nombre</th>
                    <th>Documento</th>
                    <th>Correo Electrónico</th>
                    <th>Teléfono</th>
                    <th>Edad</th>
                    <th>Estado</th>
                    <th class="text-end">Acciones</th>
                </tr>
            </thead>
            <tbody>
                @if (Model.Clientes.Count == 0)
                {
                    <tr>
                        <td colspan="7" class="text-center py-5 text-muted">
                            <i class="bi bi-people fs-1 d-block mb-2"></i>
                            No se encontraron clientes registrados con los criterios ingresados.
                        </td>
                    </tr>
                }
                else
                {
                    @foreach (var cliente in Model.Clientes)
                    {
                        <tr>
                            <td>
                                <div class="fw-bold">@cliente.Name</div>
                                <small class="text-muted">@cliente.Address</small>
                            </td>
                            <td>
                                <span class="badge bg-secondary-subtle text-secondary border font-monospace">
                                    @cliente.DocumentNumber
                                </span>
                            </td>
                            <td>
                                <a href="mailto:@cliente.Email" class="text-decoration-none">
                                    <i class="bi bi-envelope me-1"></i> @cliente.Email
                                </a>
                            </td>
                            <td>
                                <span><i class="bi bi-telephone me-1 text-muted"></i>@cliente.Phone</span>
                            </td>
                            <td>
                                @(cliente.ProcessedAge.HasValue ? $"{cliente.ProcessedAge} años" : "N/D")
                            </td>
                            <td>
                                <span class="badge @(cliente.IsActive ? "bg-success-subtle text-success" : "bg-secondary-subtle text-secondary")">
                                    @(cliente.IsActive ? "Activo" : "Suspendido")
                                </span>
                            </td>
                            <td class="text-end">
                                <div class="btn-group btn-group-sm">
                                    <a asp-action="Details" asp-route-id="@cliente.Id" class="btn btn-outline-secondary" title="Detalles">
                                        <i class="bi bi-eye"></i>
                                    </a>
                                    <a asp-action="Edit" asp-route-id="@cliente.Id" class="btn btn-outline-primary" title="Editar">
                                        <i class="bi bi-pencil"></i>
                                    </a>
                                    <form asp-action="@(cliente.IsActive ? "Suspend" : "Activate")" asp-route-id="@cliente.Id" method="post" class="d-inline">
                                        @Html.AntiForgeryToken()
                                        <button type="submit" class="btn btn-outline-@(cliente.IsActive ? "warning" : "success")" title="@(cliente.IsActive ? "Suspender" : "Activar")">
                                            <i class="bi bi-@(cliente.IsActive ? "pause-circle" : "play-circle")"></i>
                                        </button>
                                    </form>
                                </div>
                            </td>
                        </tr>
                    }
                }
            </tbody>
        </table>
    </div>
</div>

<nav class="d-flex justify-content-between align-items-center mt-3" aria-label="Paginación de clientes">
    <span class="text-muted small">@Model.TotalCount registros · página @Model.Page de @Math.Max(Model.TotalPages, 1)</span>
    <div class="btn-group btn-group-sm">
        <a asp-action="Index" asp-route-page="@(Model.Page - 1)" asp-route-pageSize="@Model.PageSize" asp-route-search="@Model.SearchTerm" asp-route-status="@Model.Status" class="btn btn-outline-secondary @(Model.Page <= 1 ? "disabled" : "")">Anterior</a>
        <a asp-action="Index" asp-route-page="@(Model.Page + 1)" asp-route-pageSize="@Model.PageSize" asp-route-search="@Model.SearchTerm" asp-route-status="@Model.Status" class="btn btn-outline-secondary @(Model.Page >= Model.TotalPages ? "disabled" : "")">Siguiente</a>
    </div>
</nav>
