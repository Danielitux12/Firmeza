@model Firmeza.Application.ViewModels.Clientes.ClienteViewModel
@{
    ViewData["Title"] = "Detalle del Cliente";
}

<div class="row justify-content-center">
    <div class="col-12 col-lg-8">
        <div class="card card-firmeza">
            <div class="card-header bg-white py-3 d-flex justify-content-between align-items-center">
                <h5 class="card-title mb-0 fw-bold">Información del Cliente #@Model.Id</h5>
                <a asp-action="Index" class="btn btn-sm btn-outline-secondary">
                    <i class="bi bi-arrow-left me-1"></i> Volver al listado
                </a>
            </div>
            <div class="card-body p-4">
                <div class="row g-4">
                    <div class="col-md-6">
                        <label class="text-muted small text-uppercase fw-semibold d-block">Nombre Completo</label>
                        <span class="fs-5 fw-bold">@Model.Name</span>
                    </div>

                    <div class="col-md-6">
                        <label class="text-muted small text-uppercase fw-semibold d-block">Número de Documento</label>
                        <span class="badge bg-secondary-subtle text-secondary border fs-6 font-monospace">@Model.DocumentNumber</span>
                    </div>

                    <div class="col-md-6">
                        <label class="text-muted small text-uppercase fw-semibold d-block">Estado</label>
                        <span class="badge @(Model.IsActive ? "bg-success-subtle text-success" : "bg-secondary-subtle text-secondary")">@(Model.IsActive ? "Activo" : "Suspendido")</span>
                    </div>

                    <div class="col-md-6">
                        <label class="text-muted small text-uppercase fw-semibold d-block">Correo Electrónico</label>
                        <a href="mailto:@Model.Email" class="text-decoration-none fs-6">
                            <i class="bi bi-envelope me-1"></i> @Model.Email
                        </a>
                    </div>

                    <div class="col-md-6">
                        <label class="text-muted small text-uppercase fw-semibold d-block">Teléfono</label>
                        <span class="fs-6"><i class="bi bi-telephone me-1 text-muted"></i>@Model.Phone</span>
                    </div>

                    <div class="col-md-4">
                        <label class="text-muted small text-uppercase fw-semibold d-block">Edad Registrada</label>
                        <span class="fs-5 fw-bold">@(Model.ProcessedAge.HasValue ? $"{Model.ProcessedAge} años" : "No calculada")</span>
                    </div>

                    <div class="col-md-8">
                        <label class="text-muted small text-uppercase fw-semibold d-block">Dirección</label>
                        <span class="fs-6">@Model.Address</span>
                    </div>
                </div>

                <hr class="my-4" />

                <div class="d-flex justify-content-end gap-2">
                    <a asp-action="Edit" asp-route-id="@Model.Id" class="btn btn-primary">
                        <i class="bi bi-pencil me-1"></i> Editar
                    </a>
                    <form asp-action="@(Model.IsActive ? "Suspend" : "Activate")" asp-route-id="@Model.Id" method="post">
                        @Html.AntiForgeryToken()
                        <button type="submit" class="btn btn-outline-@(Model.IsActive ? "warning" : "success")">
                            <i class="bi bi-@(Model.IsActive ? "pause-circle" : "play-circle") me-1"></i> @(Model.IsActive ? "Suspender" : "Activar")
                        </button>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>
