@model Firmeza.Application.ViewModels.Dashboard.DashboardViewModel
@{
    ViewData["Title"] = "Dashboard";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <div>
        <h2 class="fw-bold mb-1">Panel de Control</h2>
        <p class="text-muted mb-0">Gestión de Clientes y Empresas</p>
    </div>
</div>

<!-- Tarjetas métricas de Clientes y Empresas -->
<div class="row g-4 mb-4">
    <!-- Tarjeta 1: Clientes -->
    <div class="col-12 col-md-6">
        <div class="card card-firmeza metric-card metric-clientes p-4 h-100">
            <div class="d-flex justify-content-between align-items-start">
                <div>
                    <span class="text-muted text-uppercase fw-semibold small">Total de Clientes</span>
                    <div class="metric-number text-success">@Model.TotalClientes</div>
                    <small class="text-muted mt-2 d-block">Activos: <strong>@Model.TotalClientesActivos</strong></small>
                </div>
                <div class="bg-success-subtle text-success p-3 rounded-circle">
                    <i class="bi bi-people fs-3"></i>
                </div>
            </div>
            <hr class="my-3 text-muted" />
            <a asp-controller="Clientes" asp-action="Index" class="text-decoration-none small fw-semibold text-success d-flex align-items-center justify-content-between">
                <span>Gestionar clientes</span>
                <i class="bi bi-arrow-right"></i>
            </a>
        </div>
    </div>

    <!-- Tarjeta 2: Empresas -->
    <div class="col-12 col-md-6">
        <div class="card card-firmeza metric-card p-4 h-100" style="border-left-color: #0d6efd;">
            <div class="d-flex justify-content-between align-items-start">
                <div>
                    <span class="text-muted text-uppercase fw-semibold small">Total de Empresas</span>
                    <div class="metric-number text-primary">@Model.TotalEmpresas</div>
                    <small class="text-muted mt-2 d-block">Activas: <strong>@Model.TotalEmpresasActivas</strong></small>
                </div>
                <div class="bg-primary-subtle text-primary p-3 rounded-circle">
                    <i class="bi bi-building fs-3"></i>
                </div>
            </div>
            <hr class="my-3 text-muted" />
            <a asp-controller="Empresas" asp-action="Index" class="text-decoration-none small fw-semibold text-primary d-flex align-items-center justify-content-between">
                <span>Gestionar empresas</span>
                <i class="bi bi-arrow-right"></i>
            </a>
        </div>
    </div>
</div>

<!-- Accesos directos rápidos -->
<div class="card card-firmeza">
    <div class="card-header bg-white py-3">
        <h5 class="card-title mb-0 fw-bold">Accesos Rápidos</h5>
    </div>
    <div class="card-body">
        <div class="row g-3">
            <div class="col-md-6">
                <a asp-controller="Clientes" asp-action="Create" class="btn btn-outline-success w-100 py-3 text-start d-flex align-items-center gap-3">
                    <i class="bi bi-person-plus fs-3"></i>
                    <div>
                        <div class="fw-bold">Nuevo Cliente</div>
                        <small class="text-muted">Registrar cliente en el sistema</small>
                    </div>
                </a>
            </div>
            <div class="col-md-6">
                <a asp-controller="Empresas" asp-action="Create" class="btn btn-outline-primary w-100 py-3 text-start d-flex align-items-center gap-3">
                    <i class="bi bi-building-add fs-3"></i>
                    <div>
                        <div class="fw-bold">Nueva Empresa</div>
                        <small class="text-muted">Registrar empresa en el sistema</small>
                    </div>
                </a>
            </div>
        </div>
    </div>
</div>