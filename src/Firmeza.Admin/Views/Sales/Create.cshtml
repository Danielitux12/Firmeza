@model Firmeza.Application.ViewModels.Sales.SaleCreateViewModel
@{
    ViewData["Title"] = "Registrar Venta";
}

<div class="row justify-content-center">
    <div class="col-12 col-xl-10">
        <div class="card card-firmeza">
            <div class="card-header bg-white py-3 d-flex justify-content-between align-items-center">
                <h5 class="card-title mb-0 fw-bold">Nueva Venta</h5>
                <a asp-action="Index" class="btn btn-sm btn-outline-secondary">
                    <i class="bi bi-arrow-left me-1"></i> Volver a Ventas
                </a>
            </div>
            <div class="card-body p-4">
                @if (!ViewData.ModelState.IsValid && ViewData.ModelState[string.Empty]?.Errors.Count > 0)
                {
                    <div class="alert alert-danger shadow-sm">
                        <i class="bi bi-exclamation-triangle-fill me-2"></i>
                        @Html.ValidationSummary(true, "", new { @class = "mb-0" })
                    </div>
                }

                <form asp-action="Create" method="post" id="saleForm">
                    @Html.AntiForgeryToken()

                    <!-- Selección de Cliente -->
                    <div class="row g-3 mb-4">
                        <div class="col-md-8">
                            <label asp-for="ClienteId" class="form-label fw-bold">Seleccionar Cliente</label>
                            <select asp-for="ClienteId" class="form-select" required>
                                <option value="">-- Elige un cliente registrado --</option>
                                @foreach (var cliente in Model.AvailableClientes)
                                {
                                    <option value="@cliente.Id">@cliente.DisplayText</option>
                                }
                            </select>
                            <span asp-validation-for="ClienteId" class="text-danger small"></span>
                        </div>
                        <div class="col-md-4 d-flex align-items-end">
                            <a asp-controller="Clientes" asp-action="Create" target="_blank" class="btn btn-outline-success w-100">
                                <i class="bi bi-person-plus me-1"></i> Registrar Nuevo Cliente
                            </a>
                        </div>
                    </div>

                    <hr />

                    <!-- Sección de Ítems / Productos de la Venta -->
                    <div class="d-flex justify-content-between align-items-center mb-3">
                        <h6 class="fw-bold mb-0 text-primary">
                            <i class="bi bi-cart me-1"></i> Artículos de la Venta
                        </h6>
                        <button type="button" class="btn btn-sm btn-outline-primary" id="btnAddRow">
                            <i class="bi bi-plus-lg me-1"></i> Agregar Producto
                        </button>
                    </div>

                    <div class="table-responsive mb-4">
                        <table class="table table-bordered align-middle" id="itemsTable">
                            <thead class="table-light">
                                <tr>
                                    <th style="width: 50%;">Producto</th>
                                    <th style="width: 20%;">Precio Unit.</th>
                                    <th style="width: 15%;">Cantidad</th>
                                    <th style="width: 15%;" class="text-end">Subtotal Línea</th>
                                    <th style="width: 5%;" class="text-center"></th>
                                </tr>
                            </thead>
                            <tbody id="itemsBody">
                                <!-- Primera fila predeterminada -->
                                <tr class="item-row">
                                    <td>
                                        <select name="Items[0].ProductId" class="form-select product-select" required>
                                            <option value="">-- Selecciona producto --</option>
                                            @foreach (var prod in Model.AvailableProducts)
                                            {
                                                <option value="@prod.Id" data-price="@prod.Price" data-stock="@prod.Stock">
                                                    @prod.Name (Stock: @prod.Stock | $@prod.Price.ToString("N2"))
                                                </option>
                                            }
                                        </select>
                                    </td>
                                    <td>
                                        <input type="text" class="form-control text-end unit-price-display" value="$0.00" readonly />
                                    </td>
                                    <td>
                                        <input type="number" name="Items[0].Quantity" class="form-control text-center quantity-input" value="1" min="1" required />
                                    </td>
                                    <td class="text-end fw-semibold line-total-display">
                                        $0.00
                                    </td>
                                    <td class="text-center">
                                        <button type="button" class="btn btn-sm btn-outline-danger btn-remove-row" title="Quitar">
                                            <i class="bi bi-x-lg"></i>
                                        </button>
                                    </td>
                                </tr>
                            </tbody>
                        </table>
                    </div>

                    <!-- Resumen de Totales e Impuesto -->
                    <div class="row justify-content-end mb-4">
                        <div class="col-md-5">
                            <div class="card bg-light p-3 border">
                                <div class="d-flex justify-content-between mb-2">
                                    <span class="text-muted">Subtotal:</span>
                                    <span class="fw-bold" id="summarySubtotal">$0.00</span>
                                </div>
                                <div class="d-flex justify-content-between mb-2">
                                    <span class="text-muted">IVA (19%):</span>
                                    <span class="fw-bold text-muted" id="summaryTax">$0.00</span>
                                </div>
                                <hr class="my-2" />
                                <div class="d-flex justify-content-between fs-5">
                                    <span class="fw-bold text-primary">Total a Pagar:</span>
                                    <span class="fw-bold text-primary" id="summaryTotal">$0.00</span>
                                </div>
                            </div>
                        </div>
                    </div>

                    <div class="d-flex justify-content-end gap-2">
                        <a asp-action="Index" class="btn btn-outline-secondary">Cancelar</a>
                        <button type="submit" class="btn btn-primary px-4 fw-semibold">
                            <i class="bi bi-check-circle me-1"></i> Finalizar y Facturar Venta
                        </button>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

@section Scripts {
<script>
    // Código simple y explícito en JavaScript para agregar filas y recalcular totales en vivo
    document.addEventListener("DOMContentLoaded", function () {
        const itemsBody = document.getElementById("itemsBody");
        const btnAddRow = document.getElementById("btnAddRow");

        // Opciones de productos disponibles reutilizables para clonar filas
        const firstSelect = document.querySelector(".product-select");
        const productOptionsHtml = firstSelect ? firstSelect.innerHTML : "";

        function recalculate() {
            let subtotal = 0;
            const rows = itemsBody.querySelectorAll(".item-row");

            rows.forEach(function (row) {
                const select = row.querySelector(".product-select");
                const qtyInput = row.querySelector(".quantity-input");
                const priceDisplay = row.querySelector(".unit-price-display");
                const lineTotalDisplay = row.querySelector(".line-total-display");

                const selectedOption = select.options[select.selectedIndex];
                const price = parseFloat(selectedOption.getAttribute("data-price") || 0);
                const maxStock = parseInt(selectedOption.getAttribute("data-stock") || 0);
                let qty = parseInt(qtyInput.value || 0);

                if (qty < 1) qty = 1;
                if (maxStock > 0 && qty > maxStock) {
                    qty = maxStock;
                    qtyInput.value = maxStock;
                }

                priceDisplay.value = "$" + price.toFixed(2);
                const lineTotal = price * qty;
                lineTotalDisplay.textContent = "$" + lineTotal.toFixed(2);
                subtotal += lineTotal;
            });

            const tax = Math.round(subtotal * 0.19 * 100) / 100;
            const total = subtotal + tax;

            document.getElementById("summarySubtotal").textContent = "$" + subtotal.toFixed(2);
            document.getElementById("summaryTax").textContent = "$" + tax.toFixed(2);
            document.getElementById("summaryTotal").textContent = "$" + total.toFixed(2);
        }

        // Delegación de eventos para cambios en productos o cantidades
        itemsBody.addEventListener("change", function (e) {
            if (e.target.classList.contains("product-select") || e.target.classList.contains("quantity-input")) {
                recalculate();
            }
        });

        itemsBody.addEventListener("input", function (e) {
            if (e.target.classList.contains("quantity-input")) {
                recalculate();
            }
        });

        // Eliminar fila
        itemsBody.addEventListener("click", function (e) {
            const btn = e.target.closest(".btn-remove-row");
            if (btn) {
                const rows = itemsBody.querySelectorAll(".item-row");
                if (rows.length > 1) {
                    btn.closest(".item-row").remove();
                    reindexRows();
                    recalculate();
                } else {
                    alert("La venta debe contener al menos una fila de producto.");
                }
            }
        });

        // Agregar nueva fila
        btnAddRow.addEventListener("click", function () {
            const index = itemsBody.querySelectorAll(".item-row").length;
            const newRow = document.createElement("tr");
            newRow.className = "item-row";
            newRow.innerHTML = `
                <td>
                    <select name="Items[${index}].ProductId" class="form-select product-select" required>
                        ${productOptionsHtml}
                    </select>
                </td>
                <td>
                    <input type="text" class="form-control text-end unit-price-display" value="$0.00" readonly />
                </td>
                <td>
                    <input type="number" name="Items[${index}].Quantity" class="form-control text-center quantity-input" value="1" min="1" required />
                </td>
                <td class="text-end fw-semibold line-total-display">$0.00</td>
                <td class="text-center">
                    <button type="button" class="btn btn-sm btn-outline-danger btn-remove-row" title="Quitar">
                        <i class="bi bi-x-lg"></i>
                    </button>
                </td>
            `;
            itemsBody.appendChild(newRow);
        });

        function reindexRows() {
            const rows = itemsBody.querySelectorAll(".item-row");
            rows.forEach(function (row, idx) {
                const select = row.querySelector(".product-select");
                const qty = row.querySelector(".quantity-input");
                select.name = `Items[${idx}].ProductId`;
                qty.name = `Items[${idx}].Quantity`;
            });
        }

        recalculate();
    });
</script>
}
