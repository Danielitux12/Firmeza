@model Firmeza.Application.ViewModels.Sales.SaleDetailsViewModel
@{
    ViewData["Title"] = "Comprobante de Venta " + Model.SaleNumber;
}

<div class="row justify-content-center">
    <div class="col-12 col-xl-9">
        <div class="card card-firmeza shadow-sm">
            <div class="card-header bg-white py-3 d-flex justify-content-between align-items-center">
                <div>
                    <span class="badge bg-primary fs-6 me-2 font-monospace">@Model.SaleNumber</span>
                    <span class="text-muted small">Registrada el @Model.Date.ToLocalTime().ToString("dd/MM/yyyy HH:mm")</span>
                </div>
                <div class="d-flex gap-2">
                    <a asp-action="DownloadReceipt" asp-route-id="@Model.Id" class="btn btn-sm btn-danger">
                        <i class="bi bi-file-earmark-pdf me-1"></i> Descargar Recibo (PDF)
                    </a>
                    <button type="button" class="btn btn-sm btn-outline-secondary" onclick="window.print();">
                        <i class="bi bi-printer me-1"></i> Imprimir
                    </button>
                    <a asp-action="Index" class="btn btn-sm btn-outline-primary">
                        <i class="bi bi-arrow-left me-1"></i> Volver a Ventas
                    </a>
                </div>
            </div>

            <div class="card-body p-4 p-md-5">
                <!-- Encabezado de la factura / comprobante -->
                <div class="row mb-4 pb-3 border-bottom">
                    <div class="col-md-6">
                        <h4 class="fw-bold text-primary mb-1">
                            <i class="bi bi-hammer text-warning me-2"></i>Firmeza Materiales S.A.S.
                        </h4>
                        <p class="text-muted small mb-0">NIT: 900.123.456-7</p>
                        <p class="text-muted small mb-0">Comercialización de materiales y ferretería</p>
                    </div>
                    <div class="col-md-6 text-md-end mt-3 mt-md-0">
                        <h5 class="fw-bold mb-1">COMPROBANTE DE VENTA</h5>
                        <div class="text-muted small">Número: <strong>@Model.SaleNumber</strong></div>
                        <div class="text-muted small">Fecha: @Model.Date.ToLocalTime().ToString("dd/MM/yyyy")</div>
                    </div>
                </div>

                <!-- Datos del Cliente -->
                <div class="row mb-4">
                    <div class="col-12">
                        <div class="bg-light p-3 rounded border">
                            <h6 class="fw-bold text-uppercase small text-muted mb-2">Datos del Cliente</h6>
                            <div class="row">
                                <div class="col-md-6">
                                    <div>Cliente: <strong>@Model.ClienteName</strong></div>
                                    <div>Documento: <strong>@Model.ClienteDocument</strong></div>
                                </div>
                                <div class="col-md-6">
                                    <div>Correo: <strong>@Model.ClienteEmail</strong></div>
                                    <div>Teléfono: <strong>@Model.ClientePhone</strong></div>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>

                <!-- Detalle de productos vendidos -->
                <div class="table-responsive mb-4">
                    <table class="table table-bordered align-middle">
                        <thead class="table-light">
                            <tr>
                                <th>#</th>
                                <th>Descripción del Producto</th>
                                <th class="text-center" style="width: 15%;">Cantidad</th>
                                <th class="text-end" style="width: 20%;">Precio Unit.</th>
                                <th class="text-end" style="width: 20%;">Total Línea</th>
                            </tr>
                        </thead>
                        <tbody>
                            @{ int itemIndex = 1; }
                            @foreach (var item in Model.Items)
                            {
                                <tr>
                                    <td>@itemIndex</td>
                                    <td class="fw-semibold">@item.ProductName</td>
                                    <td class="text-center">@item.Quantity</td>
                                    <td class="text-end">$@item.UnitPrice.ToString("N2")</td>
                                    <td class="text-end fw-semibold">$@item.LineTotal.ToString("N2")</td>
                                </tr>
                                itemIndex++;
                            }
                        </tbody>
                    </table>
                </div>

                <!-- Liquidación de Totales -->
                <div class="row justify-content-end">
                    <div class="col-md-5">
                        <table class="table table-sm">
                            <tr>
                                <td class="text-muted">Subtotal:</td>
                                <td class="text-end fw-semibold">$@Model.Subtotal.ToString("N2")</td>
                            </tr>
                            <tr>
                                <td class="text-muted">IVA (19%):</td>
                                <td class="text-end fw-semibold">$@Model.Tax.ToString("N2")</td>
                            </tr>
                            <tr class="table-primary border-top">
                                <td class="fw-bold fs-5 text-primary">TOTAL:</td>
                                <td class="text-end fw-bold fs-5 text-primary">$@Model.Total.ToString("N2")</td>
                            </tr>
                        </table>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>
