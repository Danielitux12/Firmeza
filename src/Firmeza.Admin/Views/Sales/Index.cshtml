@model List<Firmeza.Application.ViewModels.Sales.SaleListItemViewModel>
@{
    ViewData["Title"] = "Historial de Ventas";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <div>
        <h2 class="fw-bold mb-1">Historial de Ventas</h2>
        <p class="text-muted mb-0">Registro y facturación de órdenes en ferretería</p>
    </div>
    <div class="d-flex gap-2">
        <a asp-action="ExportExcel" class="btn btn-outline-success">
            <i class="bi bi-file-earmark-excel me-1"></i> Exportar Excel
        </a>
        <a asp-action="ExportPdf" class="btn btn-outline-danger">
            <i class="bi bi-file-earmark-pdf me-1"></i> Exportar PDF
        </a>
        <a asp-action="Create" class="btn btn-primary">
            <i class="bi bi-cart-plus me-1"></i> Registrar Nueva Venta
        </a>
    </div>
</div>

<div class="card card-firmeza">
    <div class="table-responsive">
        <table class="table table-firmeza">
            <thead>
                <tr>
                    <th>N° Venta</th>
                    <th>Fecha y Hora</th>
                    <th>Cliente</th>
                    <th>Documento</th>
                    <th class="text-center">Artículos</th>
                    <th class="text-end">Subtotal</th>
                    <th class="text-end">IVA (19%)</th>
                    <th class="text-end">Total</th>
                    <th class="text-end">Acciones</th>
                </tr>
            </thead>
            <tbody>
                @if (Model.Count == 0)
                {
                    <tr>
                        <td colspan="9" class="text-center py-5 text-muted">
                            <i class="bi bi-receipt fs-1 d-block mb-2"></i>
                            Aún no se han registrado ventas en el sistema.
                        </td>
                    </tr>
                }
                else
                {
                    @foreach (var sale in Model)
                    {
                        <tr>
                            <td>
                                <span class="badge bg-primary-subtle text-primary border font-monospace fs-6">
                                    @sale.SaleNumber
                                </span>
                            </td>
                            <td>
                                <div>@sale.Date.ToLocalTime().ToString("dd/MM/yyyy")</div>
                                <small class="text-muted">@sale.Date.ToLocalTime().ToString("HH:mm")</small>
                            </td>
                            <td class="fw-semibold">@sale.CustomerName</td>
                            <td class="text-muted small">@sale.CustomerDocument</td>
                            <td class="text-center">
                                <span class="badge bg-light text-dark border">
                                    @sale.TotalItems unids.
                                </span>
                            </td>
                            <td class="text-end text-muted">$@sale.Subtotal.ToString("N2")</td>
                            <td class="text-end text-muted">$@sale.Tax.ToString("N2")</td>
                            <td class="text-end fw-bold text-success fs-6">
                                $@sale.Total.ToString("N2")
                            </td>
                            <td class="text-end">
                                <div class="btn-group btn-group-sm">
                                    <a asp-action="Details" asp-route-id="@sale.Id" class="btn btn-outline-primary" title="Ver Detalle">
                                        <i class="bi bi-eye"></i>
                                    </a>
                                    <a asp-action="DownloadReceipt" asp-route-id="@sale.Id" class="btn btn-outline-danger" title="Descargar Recibo en PDF">
                                        <i class="bi bi-file-earmark-pdf"></i>
                                    </a>
                                </div>
                            </td>
                        </tr>
                    }
                }
            </tbody>
        </table>
    </div>
</div>
